menu "Aether Wi-Fi configuration"

    config AETHER_WIFI_STA_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Name of the 2.4 GHz Wi-Fi network the ESP32-S3 should join.

    config AETHER_WIFI_STA_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Password for the configured Wi-Fi network.

    config AETHER_WIFI_STA_MAX_RETRY
        int "Maximum connection retries"
        range 1 100
        default 10

endmenu
